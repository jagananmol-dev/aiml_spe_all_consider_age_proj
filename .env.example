# Environment Configuration for VEDA AI
# Copy this file to .env and fill in your values

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="VEDA AI"

# ============================================
# DATABASE — PostgreSQL 16 + Apache AGE + pgvector
# ============================================
DATABASE_URL=postgresql://veda:veda_secret_2024@localhost:5432/veda_db
POSTGRES_USER=veda
POSTGRES_PASSWORD=veda_secret_2024
POSTGRES_DB=veda_db
POSTGRES_PORT=5432

# ============================================
# AUTHENTICATION — Better Auth
# ============================================
BETTER_AUTH_SECRET=your-secret-key-change-this-in-production
BETTER_AUTH_URL=http://localhost:3000
# Signs the session cookie (HMAC-SHA256). Required in production, min 16 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ============================================
# INTERNAL SERVICE AUTH
# ============================================
# Shared secret the web app sends to the intelligence service (X-Internal-Key).
# Set the same value for both; when empty the intelligence API accepts any caller.
INTERNAL_API_KEY=
INTELLIGENCE_SERVICE_URL=http://localhost:8002

# Jupyter in the intelligence container is off unless enabled, and needs a token
ENABLE_JUPYTER=0
JUPYTER_TOKEN=

# ============================================
# APACHE KAFKA
# ============================================
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=veda-ai
KAFKA_GROUP_ID=veda-ai-group

# ============================================
# MINIO (S3-COMPATIBLE OBJECT STORAGE)
# ============================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=veda_minio_access
MINIO_SECRET_KEY=veda_minio_secret_2024
MINIO_BUCKET_PREFIX=veda-tenant

# ============================================
# REDIS / VALKEY
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# OPENSEARCH
# ============================================
OPENSEARCH_URL=http://localhost:9200

# ============================================
# LLM CONFIGURATION — the company chatbot
# ============================================
# Provider: "ollama" (local, native API) | "openai" (any OpenAI-compatible server:
# vLLM, LiteLLM, LM Studio, hosted APIs). Empty = chatbot disabled.
LLM_PROVIDER=ollama
LLM_MODEL=llama3
LLM_BASE_URL=http://localhost:11434
# Bearer token for "openai" providers that need one
LLM_API_KEY=
# Context window for Ollama (tokens); 6144 fits an 8B model on a 6 GB GPU
LLM_NUM_CTX=6144
# How long Ollama keeps the model loaded between questions (default 24h)
LLM_KEEP_ALIVE=24h

# ============================================
# PIPELINE MODE
# ============================================
# "local": no Docker — uploads stored on disk, processed by the local worker,
#          embeddings kept in PostgreSQL (needs 002_document_chunks.sql applied)
# "docker": MinIO + Kafka + pgvector + Apache AGE via docker compose
PIPELINE_MODE=local
STORAGE_BACKEND=local
# Defaults to <repo>/.data/uploads
LOCAL_STORAGE_DIR=

# ============================================
# EMBEDDING MODEL
# ============================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ============================================
# MONITORING
# ============================================
# Prometheus metrics are always available via /metrics endpoints

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_DOCUMENTS_PER_HOUR=100
